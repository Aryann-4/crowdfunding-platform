# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------
# A funded private key. NEVER commit this file or use a mainnet key you care
# about in local development.
#
# For a local Anvil dry run, use Anvil account #0 (this key is public):
# PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
PRIVATE_KEY=

# RPC endpoint used when broadcasting. Not needed for `make deploy-dry`.
# Local Anvil: http://127.0.0.1:8545
RPC_URL=

# ---------------------------------------------------------------------------
# OPTIONAL — leave blank to use defaults
# ---------------------------------------------------------------------------
# Contract owner. Defaults to the deployer.
OWNER=

# Fee recipient. Defaults to OWNER.
FEE_RECIPIENT=

# Platform fee in basis points. Max 500 (5%). Defaults to 0.
PLATFORM_FEE_BPS=0
